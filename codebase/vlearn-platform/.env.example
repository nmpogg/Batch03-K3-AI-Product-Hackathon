PORT=5173

# OpenAI-compatible chat endpoint.
# For OpenAI: keep LLM_API_BASE_URL=https://api.openai.com/v1 and LLM_CHAT_PATH=/chat/completions
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_CHAT_PATH=/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2

# Optional: customize the tutor behavior without touching code.
LLM_SYSTEM_PROMPT=Bạn là VLearn Tutor cho khóa AI thực chiến K3. Trả lời ngắn gọn, ưu tiên giải thích theo slide hiện tại, đặt câu hỏi gợi mở khi người học chưa rõ mục tiêu.
